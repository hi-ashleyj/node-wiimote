{
    "name": "node-wiimote",
    "version": "0.2.0",
    "description": "Provides bindings and event listeners for Wiimotes in node",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "roll": "rollup -c"
    },
    "author": "Ashley J",
    "license": "MIT",
    "dependencies": {
        "node-hid": "^3.2.0"
    },
    "overrides": {
        "vite-plugin-dts-bundle-generator": {
            "vite": "^7.2.7"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hi-ashleyj/node-wiimote.git"
    },
    "devDependencies": {
        "vite": "^7.2.7",
        "vite-plugin-dts": "^4.5.4"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.umd.cjs"
        }
    }
}
